# Owner information form (/owner-information). Public values only — never put
# service-account keys or other private credentials in VITE_* variables.
# Copy to .env.local for local development; set the same names in Vercel for production.

# Google OAuth 2.0 "Web application" client ID (Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=

# Deployed Google Apps Script web app URL (ends with /exec)
VITE_OWNER_API_URL=
