# VISAT INSTRUMENTS API – copy to server/.env and fill in real values.
# server/.env is git-ignored. Never commit real credentials.

NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---------------------------------------------------------
# Development database (local .env). In production set these in Vercel's
# Environment Variables to the production connection string and database name.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB=visat_dev

# Automated tests only. The database name MUST end with "_test"; tests drop it.
# Replace the placeholder with a real connection string (the same one as MONGODB_URI is fine).
# If the placeholder is left in place, the database tests fail to start ("querySrv EBADNAME").
MONGODB_URI_TEST=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_TEST=visat_test

# --- Security ----------------------------------------------------------------
# Long random strings (at least 32 characters), different per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-long-random-secret>
CSRF_SECRET=<generate-a-different-long-random-secret>
SESSION_HOURS=8

# Browser origins allowed to call the API (comma-separated). Requests from the
# API's own origin are always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Number of proxies in front of the app (Vercel = 1). Used for client IPs.
TRUST_PROXY=1

# Optional tuning (defaults shown)
# BCRYPT_ROUNDS=12
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=10

# --- Initial admin (used once by `npm run seed:admin`) -----------------------
# Optional: the script asks for anything missing, and asks for the password at a hidden
# prompt. Do not keep a password in any env file (never set it on Vercel).
# INITIAL_ADMIN_NAME=Site Administrator
# INITIAL_ADMIN_EMAIL=<admin-email>
# For Preview/Production, put that environment's settings in a git-ignored file such as
# server/.env.production.local and run: node --env-file=.env.production.local src/scripts/createAdmin.js

# --- Cloudinary image storage -------------------------------------------------
# From Cloudinary Console → Settings → API Keys. Server-side only; never use these in
# frontend (VITE_*) variables. Until all three are set, image uploads return 503.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# Folder that holds this site's images (use a different one per environment, e.g. visat-instruments-dev).
CLOUDINARY_FOLDER=visat-instruments-dev
# Maximum size per uploaded image in MB (max 10).
UPLOAD_MAX_MB=5

# Public enquiry form: submissions allowed per client per rate-limit window.
# ENQUIRY_RATE_LIMIT_MAX=5
# TRACK_RATE_LIMIT_MAX=150   # consented analytics beacons per IP per window
# Public review form: submissions allowed per client per rate-limit window.
# REVIEW_RATE_LIMIT_MAX=3
