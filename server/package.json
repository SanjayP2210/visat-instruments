{
  "name": "visat-instruments-api",
  "private": true,
  "version": "1.0.0",
  "description": "VISAT INSTRUMENTS REST API (Express + MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "seed:admin": "node --env-file=.env src/scripts/createAdmin.js",
    "test": "vitest run",
    "seed:content": "node --env-file=.env src/scripts/seedContent.js",
    "media:check": "node --env-file=.env src/scripts/checkCloudinary.js",
    "media:cleanup": "node --env-file=.env src/scripts/cleanupMedia.js",
    "admin:reset-password": "node --env-file=.env src/scripts/resetAdminPassword.js",
    "reviews:sample": "node --env-file=.env src/scripts/sampleReviews.js",
    "prod:check": "node --env-file=.env.production.local src/scripts/checkProduction.js",
    "prod:media:check": "node --env-file=.env.production.local src/scripts/checkCloudinary.js",
    "prod:seed:content": "node --env-file=.env.production.local src/scripts/seedContent.js",
    "prod:seed:admin": "node --env-file=.env.production.local src/scripts/createAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
